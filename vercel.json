{
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/directories/", "destination": "/directories/index.html" },
    { "source": "/json-tools/", "destination": "/json-tools/index.html" },
    { "source": "/ai-json-tools/", "destination": "/ai-json-tools/index.html" },
    { "source": "/json-format-tools/", "destination": "/json-format-tools/index.html" },
    { "source": "/json-converter-tools/", "destination": "/json-converter-tools/index.html" },
    { "source": "/text-tools/", "destination": "/text-tools/index.html" },
    { "source": "/developer-tools/", "destination": "/developer-tools/index.html" },
    { "source": "/languages/", "destination": "/languages/index.html" },
    { "source": "/ja/", "destination": "/ja/index.html" },
    { "source": "/de/", "destination": "/de/index.html" },
    { "source": "/es/", "destination": "/es/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
